65, \"b\": [-0.26146722824297475, -2.988584094275237], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [0.08715574274765824, 0.9961946980917454], \"line\": [[4.0, -0.3499546541036963], [-4.0, 0.3499546541036963]], \"ya1\": 1.17, \"ya2\": 3.08, \"yb\": -3.0}, {\"theta\": 270, \"b\": [-5.51091059616309e-16, -3.0], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [1.83697019872103e-16, 1.0], \"line\": [[4.0, -7.34788079488412e-16], [-4.0, 7.34788079488412e-16]], \"ya1\": 1.0, \"ya2\": 3.0, \"yb\": -3.0}, {\"theta\": 275, \"b\": [0.26146722824297364, -2.988584094275237], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [-0.08715574274765786, 0.9961946980917454], \"line\": [[4.0, 0.3499546541036948], [-4.0, -0.3499546541036948]], \"ya1\": 0.82, \"ya2\": 2.9, \"yb\": -3.0}, {\"theta\": 280, \"b\": [0.5209445330007899, -2.9544232590366244], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [-0.17364817766692997, 0.9848077530122081], \"line\": [[4.0, 0.7053079228338583], [-4.0, -0.7053079228338583]], \"ya1\": 0.64, \"ya2\": 2.78, \"yb\": -3.0}, {\"theta\": 285, \"b\": [0.7764571353075609, -2.897777478867205], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [-0.25881904510252035, 0.9659258262890685], \"line\": [[4.0, 1.0717967697244888], [-4.0, -1.0717967697244888]], \"ya1\": 0.45, \"ya2\": 2.64, \"yb\": -3.0}, {\"theta\": 290, \"b\": [1.026060429977007, -2.819077862357725], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [-0.34202014332566905, 0.9396926207859083], \"line\": [[4.0, 1.455880937064811], [-4.0, -1.455880937064811]], \"ya1\": 0.26, \"ya2\": 2.48, \"yb\": -3.0}, {\"theta\": 295, \"b\": [1.2678547852220987, -2.7189233611099497], \"inside\": false, \"p\": [0.0, 0.0], \"y\": [-0.42261826174069955, 0.9063077870366499], \"line\": [[3.9999999999999996, 1.8652306326199948], [-3.9999999999999996, -1.8652306326199948]], \"ya1\": 0.06, \"ya2\": 2.3, \"yb\": -3.0}, {\"theta\": 300, \"b\": [1.5000000000000004, -2.598076211353316], \"inside\": false, \"p\": [0.16076951545867396, 0.08038475772933698], \"y\": [-0.447213595499958, 0.894427190999916], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.99}, {\"theta\": 305, \"b\": [1.7207293090531381, -2.4574561328669753], \"inside\": false, \"p\": [0.3936009940957204, 0.1968004970478602], \"y\": [-0.4472135954999579, 0.8944271909999159], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.97}, {\"theta\": 310, \"b\": [1.9283628290596178, -2.2981333293569346], \"inside\": false, \"p\": [0.6234369315049204, 0.3117184657524602], \"y\": [-0.4472135954999579, 0.8944271909999159], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.92}, {\"theta\": 315, \"b\": [2.121320343559642, -2.121320343559643], \"inside\": false, \"p\": [0.8485281374238565, 0.42426406871192823], \"y\": [-0.44721359549995787, 0.8944271909999157], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.85}, {\"theta\": 320, \"b\": [2.2981333293569333, -1.9283628290596186], \"inside\": false, \"p\": [1.0671615318616992, 0.5335807659308496], \"y\": [-0.4472135954999579, 0.8944271909999159], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.75}, {\"theta\": 325, \"b\": [2.457456132866975, -1.7207293090531395], \"inside\": false, \"p\": [1.277673182672324, 0.638836591336162], \"y\": [-0.4472135954999579, 0.8944271909999159], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.64}, {\"theta\": 330, \"b\": [2.598076211353315, -1.5000000000000013], \"inside\": false, \"p\": [1.4784609690826516, 0.7392304845413258], \"y\": [-0.447213595499958, 0.894427190999916], \"line\": [[4.0, 2.0], [-4.0, -2.0]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.5}, {\"theta\": 335, \"b\": [2.71892336110995, -1.2678547852220976], \"inside\": false, \"p\": [1.667996774799121, 0.8339983873995604], \"y\": [-0.44721359549995804, 0.8944271909999159], \"line\": [[4.0, 2.0000000000000004], [-4.0, -2.0000000000000004]], \"ya1\": -0.0, \"ya2\": 2.24, \"yb\": -2.35}, {\"theta\": 340, \"b\": [2.8190778623577253, -1.0260604299770058], \"inside\": false, \"p\": [1.844838117895378, 0.922419058947689], \"y\": [-0.44721359549995787, 0.894427190999916], \"line\": [[4.0, 1.9999999999999993], [-4.0, -1.9999999999999993]], \"ya1\": 0.0, \"ya2\": 2.24, \"yb\": -2.18}, {\"theta\": 345, \"b\": [2.897777478867205, -0.776457135307562], \"inside\": false, \"p\": [2.007639128970739, 1.0038195644853696], \"y\": [-0.447213595499958, 0.8944271909999159], \"line\": [[4.0, 2.0000000000000004], [-4.0, -2.0000000000000004]], \"ya1\": -0.0, \"ya2\": 2.24, \"yb\": -1.99}, {\"theta\": 350, \"b\": [2.954423259036624, -0.5209445330007911], \"inside\": false, \"p\": [2.1551607940289825, 1.0775803970144913], \"y\": [-0.44721359549995804, 0.8944271909999159], \"line\": [[4.0, 2.0000000000000004], [-4.0, -2.0000000000000004]], \"ya1\": -0.0, \"ya2\": 2.24, \"yb\": -1.79}, {\"theta\": 355, \"b\": [2.988584094275237, -0.26146722824297497], \"inside\": false, \"p\": [2.2862803841229993, 1.1431401920614996], \"y\": [-0.44721359549995804, 0.8944271909999159], \"line\": [[4.0, 2.0000000000000004], [-4.0, -2.0000000000000004]], \"ya1\": -0.0, \"ya2\": 2.24, \"yb\": -1.57}]}, {\"name\": \"farkasCone\", \"value\": [[0.0, 0.0], [4.0, 2.0], [4.0, 4.0], [1.3333333333333335, 4.0]]}, {\"name\": \"farkasA\", \"value\": [[2.0, 1.0], [1.0, 3.0]]}, {\"name\": \"farkasColors\", \"value\": {\"p1\": \"#4C72B0\", \"p2\": \"#DD8452\", \"weak\": \"#C44E52\", \"hull\": \"#55A868\", \"grid\": \"#BBBBBB\", \"text\": \"#333333\"}}, {\"name\": \"farkasLim\", \"value\": 4.0}]}</script>\n```\n:::\n:::\n\n\n::: {.callout-tip appearance=\"simple\"}\n**Interactive.** Turn the target $b$ with the slider. Inside the blue cone, $b$ splits\ninto nonnegative multiples of $a_1$ and $a_2$. Outside, the orange vector $y$ and its\ndashed hyperplane are the Farkas certificate.\n:::\n\n```{ojs}\n//| echo: false\nviewof farkasTheta = Inputs.range([0, 355], {\n  label: \"Direction of b (degrees)\", step: 5, value: 150\n})\n```\n\n```{ojs}\n//| echo: false\nfarkasChart = {\n  const R = farkas[Math.round(farkasTheta / 5) % farkas.length], C = farkasColors;\n  const L = farkasLim, W = 440, H = 440, m = 28;\n  const x = d3.scaleLinear([-L, L], [m, W - m]);\n  const y = d3.scaleLinear([-L, L], [H - m, m]);\n  const svg = d3.create(\"svg\").attr(\"viewBox\", [0, 0, W, H])\n      .style(\"width\", \"100%\").style(\"max-width\", \"460px\")\n      .style(\"font-family\", \"inherit\").style(\"font-size\", \"17px\");\n  const path = pts => \"M\" + pts.map(p => `${x(p[0])},${y(p[1])}`).join(\"L\") + \"Z\";\n  const defs = svg.append(\"defs\");\n  const marker = (id, color) => defs.append(\"marker\").attr(\"id\", id)\n      .attr(\"viewBox\", \"0 0 10 10\").attr(\"refX\", 9).attr(\"refY\", 5)\n      .attr(\"markerWidth\", 7).attr(\"markerHeight\", 7).attr(\"orient\", \"auto-start-reverse\")\n      .append(\"path\").attr(\"d\", \"M0,0L10,5L0,10Z\").attr(\"fill\", color);\n  marker(\"fk-black\", \"currentColor\"); marker(\"fk-b\", R.inside ? C.hull : C.weak);\n  marker(\"fk-y\", C.p2); marker(\"fk-part\", C.p1);\n  const arrow = (from, to, color, id, w = 2.2, dash = null) => {\n    const l = svg.append(\"line\").attr(\"x1\", x(from[0])).attr(\"y1\", y(from[1]))\n      .attr(\"x2\", x(to[0])).attr(\"y2\", y(to[1])).attr(\"stroke\", color)\n      .attr(\"stroke-width\", w).attr(\"marker-end\", `url(#${id})`);\n    if (dash) l.attr(\"stroke-dasharray\", dash);\n  };\n  const label = (p, text, color, dx = 6, dy = -6) =>\n    svg.append(\"text\").attr(\"x\", x(p[0]) + dx).attr(\"y\", y(p[1]) + dy)\n       .attr(\"fill\", color).text(text);\n\n  // axes and cone\n  for (const t of d3.range(-4, 5)) {\n    svg.append(\"line\").attr(\"x1\", x(t)).attr(\"x2\", x(t)).attr(\"y1\", y(-L)).attr(\"y2\", y(L))\n       .attr(\"stroke\", C.grid).attr(\"stroke-opacity\", t === 0 ? 0.9 : 0.35);\n    svg.append(\"line\").attr(\"y1\", y(t)).attr(\"y2\", y(t)).attr(\"x1\", x(-L)).attr(\"x2\", x(L))\n       .attr(\"stroke\", C.grid).attr(\"stroke-opacity\", t === 0 ? 0.9 : 0.35);\n  }\n  svg.append(\"path\").attr(\"d\", path(farkasCone)).attr(\"fill\", C.p1)\n     .attr(\"fill-opacity\", 0.2).attr(\"stroke\", C.p1).attr(\"stroke-width\", 1.2);\n  farkasA.forEach((a, i) => { arrow([0, 0], a, \"currentColor\", \"fk-black\");\n                              label(a, `a${i ? \"₂\" : \"₁\"}`, \"currentColor\"); });\n\n  if (R.inside) {\n    // parallelogram: b = x1 a1 + x2 a2\n    const [p1, p2] = R.parts;\n    svg.append(\"path\").attr(\"d\", path([[0, 0], p1, R.b, p2])).attr(\"fill\", C.hull)\n       .attr(\"fill-opacity\", 0.12).attr(\"stroke\", C.hull).attr(\"stroke-dasharray\", \"4 3\");\n    arrow([0, 0], p1, C.p1, \"fk-part\", 1.6, \"5 3\");\n    arrow([0, 0], p2, C.p1, \"fk-part\", 1.6, \"5 3\");\n  } else {\n    svg.append(\"line\").attr(\"x1\", x(R.line[0][0])).attr(\"y1\", y(R.line[0][1]))\n       .attr(\"x2\", x(R.line[1][0])).attr(\"y2\", y(R.line[1][1]))\n       .attr(\"stroke\", C.p2).attr(\"stroke-width\", 1.8).attr(\"stroke-dasharray\", \"7 4\");\n    arrow([0, 0], R.y.map(v => 1.6 * v), C.p2, \"fk-y\", 2.4);\n    label(R.y.map(v => 1.6 * v), \"y\", C.p2, 6, 14);\n  }\n  arrow([0, 0], R.b, R.inside ? C.hull : C.weak, \"fk-b\", 2.6);\n  label(R.b, \"b\", R.inside ? C.hull : C.weak);\n  return svg.node();\n}\n```\n\n```{ojs}\n//| echo: false\nfarkasText = {\n  const R = farkas[Math.round(farkasTheta / 5) % farkas.length], C = farkasColors;\n  const fmt = d3.format(\".2~f\"), box = document.createElement(\"div\");\n  box.style.minHeight = \"4.5em\";\n  box.innerHTML = R.inside\n    ? `<p><b>System I is solvable.</b> b = ${fmt(R.x[0])}·a₁ + ${fmt(R.x[1])}·a₂ with\n       both multipliers ≥ 0, so b lies in the cone. No certificate y can exist.</p>`\n    : `<p><b>System II is solvable.</b> The certificate\n       <span style=\"color:${C.p2}\">y</span> has y·a₁ = ${fmt(R.ya1)} ≥ 0 and\n       y·a₂ = ${fmt(R.ya2)} ≥ 0, but y·b = ${fmt(R.yb)} &lt; 0. The whole cone lies\n       on one side of the dashed line and b on the other, so b is not a nonnegative\n       combination of a₁ and a₂.</p>`;\n  return box;\n}\n```\n\n::: {.callout-note collapse=\"true\"}\n## Static version of this figure (for printing)\n\n::: {#cell-fig-farkas .cell execution_count=3}\n\n::: {.cell-output .cell-output-display}\n![The two cases of Farkas' lemma for $a_1 = (2, 1)$ and $a_2 = (1, 3)$. Left: $b$ (green) is inside the cone (blue), and the dashed parallelogram shows $b = x_1 a_1 + x_2 a_2$ with $x \\ge 0$. Right: $b$ (red) is outside, and the certificate $y$ (orange) satisfies $y^\\top a_1 \\ge 0$, $y^\\top a_2 \\ge 0$ but $y^\\top b < 0$: the dashed hyperplane $y^\\top z = 0$ separates the cone from $b$.](farkas-lemma_files/figure-html/fig-farkas-output-1.png){#fig-farkas width=865 height=453}\n:::\n:::\n\n\n:::\n\n## The math\n\nLet $A$ be an $m \\times n$ matrix with columns $a_1, \\dots, a_n$, and $b \\in \\mathbb{R}^m$.\n\n::: {.callout-important}\n## Theorem (Farkas' lemma)\nExactly one of the following two systems has a solution:\n\n- **(I)** $\\quad Ax = b, \\quad x \\ge 0$;\n- **(II)** $\\quad A^\\top y \\ge 0, \\quad b^\\top y < 0$.\n:::\n\n\"At most one\" is the easy direction: if both held, then\n$0 \\le (A^\\top y)^\\top x = y^\\top A x = y^\\top b < 0$, which is impossible. The content of\nthe lemma is \"at least one\": whenever (I) fails, a certificate $y$ exists.\n\n### Other versions\n\nThe same idea applies to other forms of linear systems. Each line below follows from the\nbasic version by adding slack variables or splitting free variables.\n\n| System I has a solution | exactly when System II has none |\n|---|---|\n| $Ax = b,\\ x \\ge 0$ | $A^\\top y \\ge 0,\\ b^\\top y < 0$ |\n| $Ax \\le b$ | $y \\ge 0,\\ A^\\top y = 0,\\ b^\\top y < 0$ |\n| $Ax \\le b,\\ x \\ge 0$ | $y \\ge 0,\\ A^\\top y \\ge 0,\\ b^\\top y < 0$ |\n\nThe second line is the one to remember for LP feasibility: **$Ax \\le b$ is infeasible\nexactly when some nonnegative combination of its rows reads $0 \\le (\\text{negative})$.**\nFor example, $x_1 + x_2 \\le 1$ and $-x_1 - x_2 \\le -3$ add up (with $y = (1, 1)$) to\n$0 \\le -2$.\n\n### From Farkas to LP duality\n\nTake the LP $\\max\\{c^\\top x : Ax \\le b\\}$ and its dual $\\min\\{b^\\top y : A^\\top y = c,\\ y \\ge 0\\}$.\n\n- **Weak duality** is the \"easy direction\" computation: for feasible $x$ and $y$,\n  $c^\\top x = y^\\top A x \\le y^\\top b$.\n- **Strong duality** (equal optimal values when both are feasible) needs the hard\n  direction of Farkas' lemma; see the proof sketch below.\n\nEach optimal dual vector is a certificate of optimality, just as $y$ in (II) is a\ncertificate of infeasibility.\n\n## Why it works\n\n::: {.callout-tip collapse=\"true\"}\n## Proof sketch: Farkas from separation\nLet $K = \\{Ax : x \\ge 0\\}$, the cone generated by the columns of $A$. System (I) says\n$b \\in K$. The cone $K$ is convex, and it is **closed** because it is finitely generated\n(this is the one subtle step; it follows from Carathéodory's theorem for cones or from\nthe [Minkowski–Weyl theorem](minkowski-weyl.qmd)).\n\nIf $b \\notin K$, the [separation theorem](../convexity/separating-hyperplanes.qmd) gives\n$y$ with $y^\\top b < y^\\top z$ for all $z \\in K$. Because $0 \\in K$, this gives\n$y^\\top b < 0$. Because $K$ is a cone, $y^\\top z$ cannot be negative for any $z \\in K$\n(scale $z$ up and the inequality would fail), so $y^\\top a_j \\ge 0$ for every column.\nThat is (II). In the interactive figure, $y$ is exactly $p - b$, where $p$ is the\nprojection of $b$ onto the cone.\n:::\n\n::: {.callout-tip collapse=\"true\"}\n## Proof sketch: strong duality\nLet $z^\\star = \\max\\{c^\\top x : Ax \\le b\\}$ be finite and fix $\\varepsilon > 0$. The system\n$Ax \\le b,\\ -c^\\top x \\le -(z^\\star + \\varepsilon)$ has no solution. By the second\nversion in the table, there are $y \\ge 0$ and $t \\ge 0$ with\n$$\nA^\\top y - t c = 0, \\qquad b^\\top y - t (z^\\star + \\varepsilon) < 0 .\n$$\nIf $t = 0$, then $A^\\top y = 0$ and $b^\\top y < 0$, which would make $Ax \\le b$ itself\ninfeasible, but it has the optimal solution. So $t > 0$; divide by $t$. Then $y/t$ is dual feasible with dual value\n$b^\\top y / t < z^\\star + \\varepsilon$. Since $\\varepsilon$ was arbitrary and weak\nduality gives $\\ge z^\\star$, the dual optimum equals $z^\\star$.\n:::\n\n## In practice\n\n- **Infeasibility certificates.** When an LP solver reports \"infeasible,\" it can return\n  a Farkas vector $y$ (often called a *dual ray*). It tells you which constraints,\n  combined, contradict each other.\n- **Benders feasibility cuts** come straight from Farkas' lemma: when the subproblem is\n  infeasible for the current master solution, the Farkas vector becomes a cut. See\n  [Benders Decomposition: Theory and Mechanism](../../decomposition-methods/benders-decomposition/theory-and-mechanism.qmd).\n- **Theorems of the alternative.** Many results of the form \"exactly one of two\n  systems is solvable\" exist, for strict inequalities, for equations, and so on. They\n  are all variations on this one idea.\n\n## Further reading\n\n- @schrijver1986, Chapter 7: Farkas' lemma in all its variants and LP duality.\n- @boyd2004, Section 5.8: theorems of alternatives from the duality viewpoint.\n- Previous: [The Minkowski–Weyl Theorem](minkowski-weyl.qmd). Next: linear programming\n  duality, in the [Linear Programming](../../linear-programming/index.qmd) category.\n\n",

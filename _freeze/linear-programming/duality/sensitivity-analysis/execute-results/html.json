3333332], [12.5, 25.5], [12.75, 25.916666666666668], [13.0, 26.333333333333332], [13.25, 26.75], [13.5, 27.166666666666668], [13.75, 27.583333333333332], [14.0, 28.0], [14.25, 28.0], [14.5, 28.0], [14.75, 28.0], [15.0, 28.0], [15.25, 28.0], [15.5, 28.0], [15.75, 28.0], [16.0, 28.0], [16.25, 28.0], [16.5, 28.0], [16.75, 28.0], [17.0, 28.0], [17.25, 28.0], [17.5, 28.0], [17.75, 28.0], [18.0, 28.0]]}]}</script>\n```\n:::\n:::\n\n\n::: {.callout-tip appearance=\"simple\"}\n**Interactive.** Slide the amount of wood. The wood constraint moves parallel to itself,\nthe region grows or shrinks, and the optimal vertex slides along the labor constraint.\nWhile it stays on the same pair of constraints, the profit rises by exactly $5/3$ per\nunit of wood.\n:::\n\n```{ojs}\n//| echo: false\nviewof sensB1 = Inputs.range([0, 18], {label: \"Wood available b₁\", step: 0.25, value: 8})\n```\n\n```{ojs}\n//| echo: false\nsensChart = {\n  const R = sens[Math.round(sensB1 / 0.25)], C = sensColors;\n  const W = 760, H = 380, m = 40, gap = 60, w = (W - 2 * m - gap) / 2;\n  const svg = d3.create(\"svg\").attr(\"viewBox\", [0, 0, W, H])\n      .style(\"width\", \"100%\").style(\"max-width\", \"820px\")\n      .style(\"font-family\", \"inherit\").style(\"font-size\", \"16px\");\n  // left: feasible region\n  const x = d3.scaleLinear([0, 9.5], [m, m + w]);\n  const y = d3.scaleLinear([0, 9.5], [H - m, H - m - w * (H - 2 * m) / w]);\n  const ys = d3.scaleLinear([0, 9.5], [H - m, m]);\n  svg.append(\"g\").attr(\"transform\", `translate(0,${H - m})`).call(d3.axisBottom(x).ticks(5)).attr(\"font-size\", 13);\n  svg.append(\"g\").attr(\"transform\", `translate(${m},0)`).call(d3.axisLeft(ys).ticks(5)).attr(\"font-size\", 13);\n  svg.append(\"text\").attr(\"x\", m + w / 2).attr(\"y\", H - 4).attr(\"text-anchor\", \"middle\")\n     .attr(\"fill\", \"currentColor\").text(\"chairs x₁\");\n  svg.append(\"text\").attr(\"x\", m + 4).attr(\"y\", m - 12).attr(\"fill\", \"currentColor\").text(\"tables x₂\");\n  // constraint lines\n  const line = (p, q, color, dash) => svg.append(\"line\")\n      .attr(\"x1\", x(p[0])).attr(\"y1\", ys(p[1])).attr(\"x2\", x(q[0])).attr(\"y2\", ys(q[1]))\n      .attr(\"stroke\", color).attr(\"stroke-width\", 1.4).attr(\"stroke-dasharray\", dash);\n  line([0, 7], [3.5, 0], C.p2, \"5 4\");\n  line([0, Math.min(R.b1 / 2, 9.5)], [Math.min(R.b1, 9.5), (R.b1 - Math.min(R.b1, 9.5)) / 2], C.p1, \"5 4\");\n  if (R.region.length >= 3)\n    svg.append(\"path\").attr(\"d\", \"M\" + R.region.map(p => `${x(p[0])},${ys(p[1])}`).join(\"L\") + \"Z\")\n       .attr(\"fill\", \"#888888\").attr(\"fill-opacity\", 0.22).attr(\"stroke\", \"#888888\").attr(\"stroke-width\", 1.6);\n  svg.append(\"circle\").attr(\"cx\", x(R.x[0])).attr(\"cy\", ys(R.x[1])).attr(\"r\", 8)\n     .attr(\"fill\", C.weak).attr(\"stroke\", \"white\").attr(\"stroke-width\", 1.5);\n  // right: value function\n  const x2 = d3.scaleLinear([0, 18], [m + w + gap, W - m]);\n  const y2 = d3.scaleLinear([0, 30], [H - m, m]);\n  svg.append(\"g\").attr(\"transform\", `translate(0,${H - m})`).call(d3.axisBottom(x2).ticks(6)).attr(\"font-size\", 13);\n  svg.append(\"g\").attr(\"transform\", `translate(${m + w + gap},0)`).call(d3.axisLeft(y2).ticks(6)).attr(\"font-size\", 13);\n  svg.append(\"rect\").attr(\"x\", x2(3.5)).attr(\"y\", m).attr(\"width\", x2(14) - x2(3.5))\n     .attr(\"height\", H - 2 * m).attr(\"fill\", C.hull).attr(\"fill-opacity\", 0.1);\n  svg.append(\"path\").datum(sensCurve).attr(\"fill\", \"none\").attr(\"stroke\", C.p1).attr(\"stroke-width\", 2.4)\n     .attr(\"d\", d3.line().x(d => x2(d[0])).y(d => y2(d[1])));\n  svg.append(\"circle\").attr(\"cx\", x2(R.b1)).attr(\"cy\", y2(R.z)).attr(\"r\", 7)\n     .attr(\"fill\", C.weak).attr(\"stroke\", \"white\").attr(\"stroke-width\", 1.5);\n  svg.append(\"text\").attr(\"x\", (x2(0) + x2(18)) / 2).attr(\"y\", H - 4).attr(\"text-anchor\", \"middle\")\n     .attr(\"fill\", \"currentColor\").text(\"wood b₁\");\n  svg.append(\"text\").attr(\"x\", m + w + gap + 4).attr(\"y\", m - 12).attr(\"fill\", \"currentColor\").text(\"best profit z*\");\n  return svg.node();\n}\n```\n\n```{ojs}\n//| echo: false\nsensText = {\n  const R = sens[Math.round(sensB1 / 0.25)], fmt = d3.format(\".3~f\"), box = document.createElement(\"div\");\n  const inside = R.b1 > 3.5 && R.b1 < 14;\n  const edge = R.b1 === 3.5 || R.b1 === 14;\n  box.style.minHeight = \"4.5em\";\n  box.innerHTML = `<p>With b₁ = ${fmt(R.b1)}: make ${fmt(R.x[0])} chairs and ${fmt(R.x[1])} tables,\n    profit <b>${fmt(R.z)}</b>. Shadow prices: wood ${fmt(R.y[0])}, labor ${fmt(R.y[1])}.<br>` +\n    (inside ? `Inside the range 3.5 &lt; b₁ &lt; 14: the same two constraints are tight, so wood is worth 5/3 per unit.`\n     : edge ? `At a breakpoint: two bases are optimal here, and the shadow price of wood jumps.`\n     : R.b1 < 3.5 ? `Below 3.5: wood is so scarce that only chairs are made; each unit of wood is worth 3.`\n     : `Above 14: labor is the only bottleneck; extra wood is left over and worth 0.`) + `</p>`;\n  return box;\n}\n```\n\n::: {.callout-note collapse=\"true\"}\n## Static version of this figure (for printing)\n\n::: {#cell-fig-sens-static .cell execution_count=4}\n\n::: {.cell-output .cell-output-display}\n![The workshop's feasible region and optimal vertex (red) for three amounts of wood. From $b_1 = 5$ to $b_1 = 11$ the optimum slides along the labor constraint and the same two constraints stay tight. At $b_1 = 16$, beyond the range, wood is left over and the optimum is $(0, 7)$.](sensitivity-analysis_files/figure-html/fig-sens-static-output-1.png){#fig-sens-static width=992 height=356}\n:::\n:::\n\n\n:::\n\n## Why it works\n\n::: {.callout-tip collapse=\"true\"}\n## Proof sketch: the value function is concave and its slopes are the duals\nBy strong duality, $z^\\star(b) = \\min\\{b^\\top y : A^\\top y \\ge c,\\ y \\ge 0\\}$. The dual\nfeasible region does not depend on $b$, and by the\n[fundamental theorem](../modeling-and-geometry/geometry-of-lp.qmd) the minimum is\nattained at one of its finitely many vertices $y^1, \\dots, y^K$. So\n$$\nz^\\star(b) = \\min_k\\ b^\\top y^k ,\n$$\na minimum of finitely many linear functions of $b$. That is concave and piecewise\nlinear, and on each piece the slope is the active vertex $y^k$, the optimal dual solution.\n:::\n\n## In practice\n\n- **Solvers report all of this**: dual values (shadow prices), reduced costs, and the\n  ranges, often under names like \"marginal,\" \"dual,\" \"RHS ranging,\" and \"cost ranging.\"\n- **Read shadow prices with their ranges.** \"Wood is worth 5/3\" is only true for small\n  changes. Large changes need a re-solve, or the full piecewise-linear curve.\n- **Degenerate optima** (more tight constraints than needed) can make shadow prices\n  one-sided: the price for a little more of a resource differs from the price for a\n  little less.\n- **Shadow prices drive decomposition.** Column generation uses reduced costs to decide\n  which new columns are worth adding; see\n  [Dantzig–Wolfe](../../decomposition-methods/dantzig-wolfe/theory-and-mechanism.qmd).\n\n## Further reading\n\n- @vanderbei2020, Chapter 7.\n- Previous: [LP Duality](lp-duality.qmd). Next:\n  [The Simplex Method](../algorithms/simplex-method.qmd).\n\n",
